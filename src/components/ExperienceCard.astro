---
import { Icon } from "astro-icon/components";

interface Skill {
  name: string;
  icon: string;
}

interface Props {
  date: string;
  title: string;
  subtitle: string;
  bullets?: string[];
  description?: string;
  companyLogo?: string;
  technologies?: Skill[];
}

import { resumeData } from "../data/resume";

const {
  date,
  title,
  subtitle,
  bullets,
  description,
  companyLogo,
  technologies,
} = Astro.props;

let mainDate = date;
let subDate = "";
if (date.includes(" (")) {
  const parts = date.split(" (");
  mainDate = parts[0];
  subDate = "(" + parts[1];
}

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';
const skillsCategories = resumeData[lang].skills;

function getCategoryIndex(techName: string) {
  for (let i = 0; i < skillsCategories.length; i++) {
    if (skillsCategories[i].items.some((item) => item.name === techName)) {
      return i;
    }
  }
  return 999;
}

const sortedTechnologies = technologies ? [...technologies].sort((a, b) => {
  const idxA = getCategoryIndex(a.name);
  const idxB = getCategoryIndex(b.name);
  if (idxA !== idxB) {
    return idxA - idxB;
  }
  return a.name.localeCompare(b.name);
}) : [];
---

<article class="exp-card">
  <header class="exp-header">
    {
      companyLogo ? (
        <img src={companyLogo} alt={`${subtitle} logo`} class="company-logo" />
      ) : (
        <div class="company-logo placeholder" />
      )
    }
    <div class="exp-heading">
      <h3>{title}</h3>
      <span class="subtitle">{subtitle}</span>
      <span class="date">
        {mainDate}
        {subDate && <> {subDate}</>}
      </span>
    </div>
  </header>

  {(description || (bullets && bullets.length > 0)) && (
    <div class="card-body">
      {description && <p>{description}</p>}
      {bullets && bullets.length > 0 && (
        <ul>
          {bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      )}
    </div>
  )}

  {sortedTechnologies.length > 0 && (
    <div class="technologies-container">
      {sortedTechnologies.map((tech) => (
        <div class="tech-badge" title={tech.name}>
          {tech.icon.includes('/') || tech.icon.includes('.') ? (
            <img src={tech.icon} alt="" class="tech-badge-icon" />
          ) : (
            <Icon name={tech.icon} class="tech-badge-icon" />
          )}
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
  )}
</article>

<style>
  .exp-card {
    container-type: inline-size;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 12px;
    background-color: var(--bg-card, #1e293b);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .exp-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }

  .exp-heading {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .company-logo {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    object-fit: contain;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    padding: 8px;
  }

  .company-logo.placeholder {
    background-color: rgba(59, 130, 246, 0.2);
  }

  h3 {
    margin: 0;
    font-size: 1.3rem;
    color: #fff;
    line-height: 1.2;
  }

  .subtitle {
    color: var(--accent-light, #60a5fa);
    font-weight: 600;
  }

  .date {
    color: var(--text-muted, #94a3b8);
    font-size: 0.85rem;
    font-style: italic;
  }

  .card-body {
    color: var(--text-main, #cbd5e1);
    font-size: 0.9rem;
    line-height: 1.5;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .card-body ul {
    padding-left: 1.2rem;
  }

  .card-body li + li {
    margin-top: 0.4rem;
  }

  .technologies-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    margin-top: auto;
  }

  .tech-badge {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background-color: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .tech-badge-icon {
    width: 1rem;
    height: 1rem;
  }

  /* Wide cards (vertical list): logo beside the heading, left-aligned content */
  @container (min-width: 560px) {
    .exp-header {
      flex-direction: row;
      text-align: left;
      gap: 1.2rem;
    }
    .technologies-container {
      justify-content: flex-start;
    }
  }
</style>
