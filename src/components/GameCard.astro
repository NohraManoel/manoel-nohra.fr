---
// src/components/GameCard.astro
import { Icon } from 'astro-icon/components';
import type { Skill } from '../data/resume';

interface Props {
  title: string;
  description: string | string[];
  tags: string[];
  technologies: Skill[];
  media?: string[]; 
  link: string;
}

const { title, description, tags = [], technologies = [], media = [], link } = Astro.props;

function getYoutubeEmbedUrl(url: string) {
  if (url.includes('youtube.com') || url.includes('youtu.be')) {
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    if (match && match[2].length === 11) {
      return `https://www.youtube.com/embed/${match[2]}?rel=0&modestbranding=1`;
    }
  }
  return null;
}

const mainMedia = media.length > 0 ? media[0] : null;
const subMedia = media.length > 1 ? media.slice(1) : [];

const sortedTags = [...tags].sort((a, b) => a.localeCompare(b));
const sortedTechs = [...technologies].sort((a, b) => a.name.localeCompare(b.name));

const searchText = [
  title, 
  ...sortedTags, 
  ...sortedTechs.map(t => t.name), 
  ...(Array.isArray(description) ? description : [description])
].join(' ').toLowerCase();

const tagsStr = sortedTags.map(t => t.toLowerCase()).join(',');
const techsStr = sortedTechs.map(t => t.name.toLowerCase()).join(',');
---

<div 
  class="game-card"
  data-title={title.toLowerCase()}
  data-tags={tagsStr}
  data-techs={techsStr}
  data-search-text={searchText}
>
  {media.length > 0 ? (
    <div class="media-gallery">
      <div class="main-media">
        {mainMedia && getYoutubeEmbedUrl(mainMedia) && (
          <iframe 
            src={getYoutubeEmbedUrl(mainMedia)} 
            title={`YouTube video player for ${title}`}
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
          />
        )}
        {mainMedia && !getYoutubeEmbedUrl(mainMedia) && mainMedia.endsWith('.mp4') && (
          <video src={mainMedia} autoplay loop muted playsinline />
        )}
        {mainMedia && !getYoutubeEmbedUrl(mainMedia) && !mainMedia.endsWith('.mp4') && (
          <img src={mainMedia} alt={`Visual of ${title}`} loading="lazy" />
        )}
      </div>
      {subMedia.length > 0 && (
        <div class={`sub-media ${subMedia.length > 3 ? 'is-carousel' : ''}`}>
          <div class="sub-media-track">
            {subMedia.map((item) => (
              <div class="sub-media-item">
                {getYoutubeEmbedUrl(item) && (
                  <iframe 
                    src={getYoutubeEmbedUrl(item)} 
                    title={`YouTube video player for ${title}`}
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                  />
                )}
                {!getYoutubeEmbedUrl(item) && item.endsWith('.mp4') && (
                  <video src={item} autoplay loop muted playsinline />
                )}
                {!getYoutubeEmbedUrl(item) && !item.endsWith('.mp4') && (
                  <img src={item} alt={`Thumbnail of ${title}`} loading="lazy" />
                )}
              </div>
            ))}
            {/* Duplicate for infinite marquee if it's a carousel */}
            {subMedia.length > 3 && subMedia.map((item) => (
              <div class="sub-media-item" aria-hidden="true">
                {getYoutubeEmbedUrl(item) && (
                  <iframe 
                    src={getYoutubeEmbedUrl(item)} 
                    title={`YouTube video player for ${title}`}
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                    tabindex="-1"
                  />
                )}
                {!getYoutubeEmbedUrl(item) && item.endsWith('.mp4') && (
                  <video src={item} autoplay loop muted playsinline tabindex="-1" />
                )}
                {!getYoutubeEmbedUrl(item) && !item.endsWith('.mp4') && (
                  <img src={item} alt={`Thumbnail of ${title}`} loading="lazy" />
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  ) : (
    <div class="image-placeholder">
      <span>Pas de média</span>
    </div>
  )}

  <div class="content">
    <div class="header-row">
      <h3>{title}</h3>
      <div class="tags-container">
        {sortedTags.map((tag) => (
          <span class="badge">{tag}</span>
        ))}
      </div>
    </div>
    
    {sortedTechs.length > 0 && (
      <div class="technologies-container">
        {sortedTechs.map(tech => (
          <span class="tech-badge" title={tech.name}>
            <Icon name={tech.icon} class="tech-icon" />
            <span>{tech.name}</span>
          </span>
        ))}
      </div>
    )}
    
    <div class="description-container">
      {Array.isArray(description) ? (
        <div class="project-description-wrapper">
          <p class="project-intro">{description[0]}</p>
          <ul class="project-bullets">
            {description.slice(1).map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>
      ) : (
        <p>{description}</p>
      )}
    </div>
    <a href={link} target="_blank" rel="noopener noreferrer" class="btn">
      {Astro.currentLocale === 'en' ? 'View Project' : 'Voir le projet'}
    </a>
  </div>
</div>

<script>
  // Lightbox logic
  document.addEventListener('DOMContentLoaded', () => {
    if (!document.getElementById('global-lightbox')) {
      const lightbox = document.createElement('div');
      lightbox.id = 'global-lightbox';
      lightbox.innerHTML = `
        <div class="lightbox-backdrop"></div>
        <button class="lightbox-close" aria-label="Close">&times;</button>
        <div class="lightbox-content"></div>
      `;
      document.body.appendChild(lightbox);

      const closeLightbox = () => {
        lightbox.classList.remove('active');
        const content = lightbox.querySelector('.lightbox-content');
        if (content) content.innerHTML = ''; // Clear content to stop videos
      };

      lightbox.querySelector('.lightbox-backdrop')?.addEventListener('click', closeLightbox);
      lightbox.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });
    }

    const lightbox = document.getElementById('global-lightbox')!;
    const content = lightbox.querySelector('.lightbox-content')!;

    // Attach click listeners to all images and videos in media galleries
    document.querySelectorAll('.game-card .media-gallery img, .game-card .media-gallery video').forEach(mediaEl => {
      mediaEl.classList.add('lightbox-trigger');

      mediaEl.addEventListener('click', (e) => {
        const clone = (e.currentTarget as HTMLElement).cloneNode(true) as HTMLElement;
        clone.classList.remove('lightbox-trigger');
        
        // If it's a video, add controls and unmute for the enlarged view
        if (clone.tagName === 'VIDEO') {
          (clone as HTMLVideoElement).controls = true;
          (clone as HTMLVideoElement).muted = false;
        }

        content.innerHTML = '';
        content.appendChild(clone);
        lightbox.classList.add('active');
      });
    });
  });
</script>

<style>
  :global(#global-lightbox) {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  :global(#global-lightbox.active) {
    opacity: 1;
    pointer-events: auto;
  }

  :global(.lightbox-backdrop) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 15, 29, 0.95);
    backdrop-filter: blur(5px);
    cursor: zoom-out;
  }

  :global(.lightbox-close) {
    position: absolute;
    top: 20px;
    right: 30px;
    background: none;
    border: none;
    color: #fff;
    font-size: 3rem;
    cursor: pointer;
    z-index: 100000;
    line-height: 1;
    padding: 0;
    transition: color 0.2s;
  }
  
  :global(.lightbox-close:hover) {
    color: var(--accent-light, #60a5fa);
  }

  :global(.lightbox-content) {
    position: relative;
    z-index: 100000;
    max-width: 90vw;
    max-height: 90vh;
  }

  :global(.lightbox-content img), :global(.lightbox-content video) {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.6);
  }

  .lightbox-trigger {
    cursor: zoom-in;
  }

  .game-card {
    background-color: var(--bg-card, #1e293b);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), 
                box-shadow 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), 
                border-color 0.3s ease;
    will-change: transform, box-shadow;
  }

  .game-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent-light, #60a5fa);
    box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
  }

  /* Gallery Layout */
  .media-gallery {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background-color: #0f172a;
  }

  .main-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    position: relative;
    overflow: hidden;
  }

  .sub-media {
    width: 100%;
    overflow: hidden;
    background: #000;
    container-type: inline-size;
  }

  .sub-media-track {
    display: flex;
    gap: 2px;
  }

  .sub-media:not(.is-carousel) .sub-media-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    width: 100%;
  }

  .is-carousel .sub-media-track {
    width: max-content;
    animation: scroll-carousel 20s linear infinite;
  }

  .is-carousel:hover .sub-media-track {
    animation-play-state: paused;
  }

  @keyframes scroll-carousel {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - 1px)); }
  }

  .sub-media-item {
    aspect-ratio: 16 / 9;
    background: #000;
    position: relative;
    overflow: hidden;
  }

  .is-carousel .sub-media-item {
    width: calc(100cqw / 3 - 2px); /* Exactly 3 items visible, minus gap */
    flex-shrink: 0;
  }

  /* Media Reset */
  .main-media img, .main-media video, .main-media iframe,
  .sub-media-item img, .sub-media-item video, .sub-media-item iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
    display: block;
    transition: transform 0.4s ease;
  }

  .game-card:hover .main-media img,
  .game-card:hover .main-media video,
  .game-card:hover .sub-media-item img,
  .game-card:hover .sub-media-item video {
    transform: scale(1.05);
  }

  .image-placeholder {
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background-color: #0f172a;
  }

  /* Content */
  .content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    flex: 1;
  }

  .header-row {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  h3 { 
    font-size: 1.5rem; 
    color: #fff; 
    margin: 0;
    line-height: 1.2;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge {
    background-color: rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .technologies-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 1rem;
    background-color: rgba(15, 23, 42, 0.5);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.03);
  }

  .tech-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: rgba(59, 130, 246, 0.15);
    color: var(--accent-light, #60a5fa);
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  
  .tech-badge:hover {
    background-color: rgba(59, 130, 246, 0.25);
    transform: translateY(-2px);
  }

  .tech-icon {
    width: 1.2em;
    height: 1.2em;
  }

  .description-container {
    flex: 1;
  }

  p { 
    color: var(--text-muted, #94a3b8); 
    font-size: 0.95rem; 
    line-height: 1.6; 
    margin: 0;
  }
  
  .project-intro {
    color: var(--text-main, #e2e8f0);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0.8rem;
  }

  .project-bullets {
    color: var(--text-muted, #94a3b8);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    padding-left: 1.2rem;
    list-style-type: disc;
  }

  .project-bullets li {
    margin-bottom: 0.5rem;
  }
  
  .btn {
    margin-top: 0.5rem;
    background-color: var(--accent, #3b82f6);
    color: #fff;
    padding: 0.7rem 1rem;
    text-align: center;
    border-radius: 6px;
    font-weight: 600;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .btn:hover { 
    background-color: var(--accent-light, #60a5fa); 
  }
  
  .btn:active {
    transform: scale(0.98);
  }
</style>