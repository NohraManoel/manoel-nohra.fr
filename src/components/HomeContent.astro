---
// src/components/HomeContent.astro
import GameCard from './GameCard.astro';
import ProjectFilter from './ProjectFilter.astro';
import { translations, links } from '../data/translations';
import { Icon } from 'astro-icon/components';
import { projects } from '../data/projects';

interface Props {
  lang: 'en' | 'fr';
}

const { lang } = Astro.props;
const t = translations[lang];

const allTags = Array.from(new Set(projects.flatMap(p => p.tags[lang])))
  .filter(tag => !/^\d{4}$/.test(tag.toString().trim()))
  .sort((a, b) => a.localeCompare(b));
const allTechs = Array.from(new Set(projects.flatMap(p => p.technologies.map(tech => tech.name))))
  .sort((a, b) => a.localeCompare(b));
---

<div class="home-container animate-fade-in">
  <section class="hero">
    <h1 fragment set:html={t.heroTitle}></h1>
    <p>{t.heroSubtitle}</p>
    <div class="hero-actions">
      <a href="#games" class="hero-btn primary">{t.heroCtaGames}</a>
      <a href={`mailto:${links.email}`} class="hero-btn">{t.heroCtaContact}</a>
      <a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="hero-btn">LinkedIn</a>
      <a href={links.github} target="_blank" rel="noopener noreferrer" class="hero-btn">GitHub</a>
      <a href={links.itch} target="_blank" rel="noopener noreferrer" class="hero-btn">itch.io</a>
    </div>
  </section>

  <section class="about-section" id="about">
    <h2>{t.aboutTitle}</h2>
    <p class="about-lead">{t.aboutLead}</p>
    <div class="center-title-wrapper">
      <h3 class="bento-title highlight-gradient large-title">{t.aboutDetailsTitle}</h3>
    </div>

    <div class="about-content">
      <div class="about-profile">
        <img src="/images/profile.jpg" alt="Manoël Nohra" class="profile-img" />
      </div>
      
      <div class="about-details">

        <div class="bento-grid">
          <div class="bento-item bento-wide">
            <div class="icon-circle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="details-icon" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            </div>
            <div class="bento-content">
              <strong>{t.labelWork}</strong>
              <span>🇨🇦 {t.valWorkCA}</span>
              <span>🇪🇺 {t.valWorkEU}</span>
            </div>
          </div>
          <div class="bento-item bento-wide">
            <div class="icon-circle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="details-icon" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="bento-content">
              <strong>{t.labelEmail}</strong>
              <a href={`mailto:${links.email}`} class="text-link">{links.email}</a>
            </div>
          </div>
          <div class="bento-item bento-wide">
            <div class="icon-circle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="details-icon" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"></path></svg>
            </div>
            <div class="bento-content">
              <strong>{t.labelDegree}</strong>
              <span>{t.valDegree}</span>
              <span class="degree-meta">{t.valDegreeMeta}</span>
            </div>
          </div>
          <div class="bento-item bento-wide">
            <div class="icon-circle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="details-icon" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            </div>
            <div class="bento-content">
              <strong>{t.labelLinks}</strong>
              <div class="logo-links">
                <a href={links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><Icon name="simple-icons:linkedin" /></a>
                <a href={links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub"><Icon name="simple-icons:github" /></a>
                <a href={links.itch} target="_blank" rel="noopener noreferrer" aria-label="itch.io" title="itch.io"><Icon name="simple-icons:itchdotio" /></a>
                <a href={t.cvHref} download aria-label={t.downloadCv} title={t.downloadCv}><Icon name="mdi:file-download-outline" /></a>
              </div>
            </div>
          </div>

          <div class="bento-item bento-full bento-games">
            <div class="icon-circle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="details-icon" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2" ry="2"></rect><path d="M6 12h4M8 10v4M15 13h.01M18 11h.01"></path></svg>
            </div>
            <div class="bento-content">
              <strong>{t.favoriteGamesTitle}</strong>
              <div class="games-tags">
                <span class="game-tag">Rocket League <small>(SSL)</small></span>
                <span class="game-tag">Metaphor: ReFantazio</span>
                <span class="game-tag">Final Fantasy X</span>
                <span class="game-tag">Hollow Knight: Silksong</span>
                <span class="game-tag">Elden Ring</span>
                <span class="game-tag">Zelda: Tears of the Kingdom</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="games-section" id="games">
    <h2>{t.myGamesTitle}</h2>
    <ProjectFilter allTags={allTags} allTechs={allTechs} lang={lang} />
    <div class="games-grid">
      {projects.map((project) => (
        <GameCard 
          title={project.title}
          description={project.description[lang]}
          tags={project.tags[lang]}
          technologies={project.technologies}
          media={project.media}
          link={project.link}
        />
      ))}
    </div>
  </section>
</div>

<style>
  .home-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0;
  }

  /* Fade-in Animation */
  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Centrage global du contenu de la page */
  .hero, .about-section, .games-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  /* Style de la section d'introduction */
  .hero {
    text-align: center;
    padding: 6rem 1rem;
    position: relative;
    border-radius: 24px;
    margin-bottom: 2rem;
    background: radial-gradient(circle at 50% 50%, rgba(59, 130, 246, 0.1) 0%, rgba(7, 11, 20, 0) 70%);
    border: 1px solid rgba(255, 255, 255, 0.03);
  }

  .hero h1 {
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
    color: #fff;
    line-height: 1.2;
    background: linear-gradient(135deg, #fff 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: textReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero :global(.highlight) {
    background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
  }

  .hero p {
    font-size: 1.25rem;
    color: var(--text-muted, #94a3b8);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    animation: textReveal 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2rem;
    animation: textReveal 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-btn {
    padding: 0.7rem 1.4rem;
    border-radius: 8px;
    font-weight: 600;
    color: var(--text-main);
    background-color: var(--bg-card);
    border: 1px solid var(--border-light);
    transition: all 0.2s ease;
  }

  .hero-btn:hover {
    color: #fff;
    border-color: var(--border-glow);
    transform: translateY(-2px);
  }

  .hero-btn.primary {
    background: linear-gradient(135deg, var(--accent, #3b82f6) 0%, #2563eb 100%);
    border-color: transparent;
    color: #fff;
  }

  .hero-btn.primary:hover {
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
  }

  @keyframes textReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Titres de sections */
  .about-section h2, .games-section h2 {
    font-size: 2rem;
    color: #fff;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.5rem;
  }

  /* Section About Me */
  .about-lead {
    text-align: center;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    color: var(--text-main, #e2e8f0);
    line-height: 1.6;
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  .about-content {
    display: flex;
    gap: 3rem;
    align-items: center;
  }

  .about-profile {
    flex-shrink: 0;
    width: 300px;
    align-self: center;
  }

  .profile-img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    object-fit: cover;
  }

  .about-details {
    flex: 1;
  }

  .about-details h3 {
    margin-bottom: 1.5rem;
  }

  .highlight-gradient {
    font-size: 2.2rem !important;
    font-weight: 800;
    margin-bottom: 2rem !important;
    background: linear-gradient(135deg, #fff 0%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .center-title-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 2rem;
    margin-bottom: 3rem;
  }

  .large-title {
    font-size: 2.8rem !important;
    margin-bottom: 0 !important;
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .bento-item {
    background-color: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    backdrop-filter: blur(12px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bento-item:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--border-glow);
    transform: translateY(-4px) scale(1.01);
    box-shadow: 0 10px 30px rgba(59, 130, 246, 0.1);
  }

  .bento-item:hover .icon-circle {
    background-color: rgba(59, 130, 246, 0.25);
    color: var(--accent-light);
    transform: scale(1.1);
  }

  .bento-wide {
    grid-column: 1 / -1;
  }
  
  .bento-full {
    grid-column: 1 / -1;
    /* Uses default .bento-item flex layout */
  }

  .bento-full .bento-content {
    flex-direction: column;
    gap: 0.8rem;
  }

  .icon-circle {
    width: 42px;
    height: 42px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .details-icon {
    width: 18px;
    height: 18px;
    color: var(--accent-light, #60a5fa);
  }

  .bento-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--text-main, #e2e8f0);
    font-size: 0.95rem;
    line-height: 1.4;
    width: 100%;
  }

  .bento-content strong {
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.8;
  }

  .degree-meta {
    color: var(--text-muted, #94a3b8);
    font-size: 0.85rem;
  }

  .text-link {
    color: var(--accent-light, #60a5fa);
    text-decoration: none;
    transition: color 0.2s;
  }

  .text-link:hover {
    color: #fff;
  }

  .logo-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .logo-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    color: var(--text-main);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-light);
    transition: all 0.2s ease;
  }

  .logo-links a:hover {
    color: var(--accent-light);
    border-color: var(--border-glow);
    transform: translateY(-2px);
  }

  .logo-links svg {
    width: 22px;
    height: 22px;
  }

  /* Grille réactive pour les GameCards */
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(450px, 100%), 1fr));
    gap: 2.5rem;
  }

  /* Ajustements pour tablettes et mobiles */
  @media (max-width: 768px) {
    .about-content {
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }
    .about-profile {
      width: 250px;
    }
    .bento-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 500px) {
    .games-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .hero h1 {
      font-size: 2.2rem;
    }
  }

  /* --- Section Jeux Favoris --- */
  .bento-games {
    /* Clear old margin/padding from old favorite-games-container if needed */
    margin: 0;
  }

  .bento-games strong {
    /* Specific styles for games bento title if needed */
  }

  .games-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .game-tag {
    background-color: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: var(--accent-light, #60a5fa);
    padding: 0.3rem 0.8rem;
    border-radius: 20px; /* Bords bien arrondis style capsule */
    font-size: 0.9rem;
    font-weight: 500;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .game-tag small {
    color: #94a3b8;
    font-weight: normal;
    margin-left: 0.2rem;
  }

  /* Petit effet interactif discrets au survol */
  .game-tag:hover {
    background-color: rgba(59, 130, 246, 0.2);
    border-color: var(--accent-light, #60a5fa);
    transform: scale(1.03);
  }
</style>
